<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ 包可见性：没有它目标进程看不到 LSPFRIFA 的 config_provider，
         binder 握手会报 Unknown authority。见 2026-11-06 真机日志。 -->
    <queries>
        <package android:name="com.bail.lspfrifa" />
    </queries>

    <!-- MIUI/HyperOS 实测：光有 <queries> 不够，系统仍会把模块包过滤掉
         （getApplicationInfo 抛 NameNotFoundException），必须再声明
         QUERY_ALL_PACKAGES（normal 级，装机即授）才能看到其他包。 -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="TestTarget"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
